---
cluster: "mycluster"
form:
  - version
  - auto_accounts
  - bc_num_hours
  - auto_queues
  - num_cores
  - bc_email_on_started
attributes:
  bc_num_hours:
    max: 24
    help: "Maximum walltime for the session (hours)."
  num_cores:
    widget: "number_field"
    label: "Number of cores"
    value: 1
    help: |
      Number of cores to request for the job (4 GB per core unless requesting whole node).
    min: 1
    max: 64
    step: 1
  version:
    widget: select
    label: "FastQC version"
    help: "Select the version of FastQC to launch."
    options:
      - ["FastQC 0.12.1", "/full/path/to/software/apptainer_images/fastqc/fastqc_0.12.1.sif"]