<%-
  cores = bc_num_slots.blank? ? 1 : bc_num_slots.to_i
  mem   = mem_per_cpu.blank? ? 4 : mem_per_cpu.to_i
  slurm_args = ["--nodes", "1", "--ntasks-per-node", "#{cores}", "--mem-per-cpu", "#{mem}G"]
-%>
---
batch_connect:
  template: "vnc"
script:
  native:
  <%- slurm_args.each do |arg| %>
  - "<%= arg %>"
  <%- end %>