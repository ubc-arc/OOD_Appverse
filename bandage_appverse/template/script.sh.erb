#!/usr/bin/env bash
set -euo pipefail

module purge
cd "${HOME}"

# -----------------------------------------------------------------------
# Set up VNC / Xfce desktop environment
# -----------------------------------------------------------------------
export SEND_256_COLORS_TO_REMOTE=1
export XDG_CONFIG_HOME="<%= session.staged_root.join("config") %>"
export XDG_DATA_HOME="<%= session.staged_root.join("share") %>"
export XDG_CACHE_HOME="$(mktemp -d)"
export $(dbus-launch)

xfwm4 --compositor=off --sm-client-disable &
xsetroot -solid "#D3D3D3"
xfsettingsd --sm-client-disable &
xfdesktop --quit 2>/dev/null || true

# -----------------------------------------------------------------------
# Load required modules
# Update the module name to match your cluster's module system
# -----------------------------------------------------------------------
module load apptainer || { echo "ERROR: Failed to load module apptainer"; exit 1; }

echo "=== Environment ==="
module list
echo "DISPLAY=${DISPLAY}"
glxinfo | grep -i render 2>/dev/null || echo "glxinfo not available"

# -----------------------------------------------------------------------
# Verify the container image exists before launching
# -----------------------------------------------------------------------
SIF="<%= context.version %>"
if [[ -z "${SIF}" ]]; then
  echo "ERROR: No container image selected."
  exit 1
fi
if [[ ! -f "${SIF}" ]]; then
  echo "ERROR: Container image not found: ${SIF}"
  echo "Please build the container and update the path in form.yml."
  exit 1
fi

# -----------------------------------------------------------------------
# Launch Bandage GUI via Apptainer in the background
# -----------------------------------------------------------------------
apptainer exec \
  --env DISPLAY="${DISPLAY}" \
  --env XDG_RUNTIME_DIR="/tmp/runtime-$$" \
  -B /tmp/.X11-unix:/tmp/.X11-unix \
  -B "${HOME}:${HOME}" \
  "${SIF}" Bandage &
BANDAGE_PID=$!

# -----------------------------------------------------------------------
# Poll until Bandage window appears using xdotool (inside container),
# then maximize
# -----------------------------------------------------------------------
echo "Waiting for Bandage window..."
for i in $(seq 1 30); do
  sleep 2
  if ! kill -0 $BANDAGE_PID 2>/dev/null; then
    echo "ERROR: Bandage process has exited unexpectedly."
    exit 1
  fi
  WIN_ID=$(apptainer exec \
    --env DISPLAY="${DISPLAY}" \
    -B /tmp/.X11-unix:/tmp/.X11-unix \
    "${SIF}" \
    xdotool search --name "Bandage" 2>/dev/null | tail -1)
  if [[ -n "${WIN_ID}" ]]; then
    echo "Bandage window found (ID: ${WIN_ID}), maximizing..."
    apptainer exec \
      --env DISPLAY="${DISPLAY}" \
      -B /tmp/.X11-unix:/tmp/.X11-unix \
      "${SIF}" \
      xdotool windowsize "${WIN_ID}" 99999 99999
    break
  fi
  echo "Attempt ${i}/30: waiting for Bandage window..."
done

# Keep the session alive until Bandage exits
wait $BANDAGE_PID
