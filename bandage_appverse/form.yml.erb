---
# Set cluster to the id matching your /etc/ood/config/clusters.d/<cluster>.yml
cluster: "mycluster"
form:
  - version
  - auto_accounts
  - bc_num_hours
  - auto_queues
  - bc_num_slots
  - bc_vnc_resolution
  - bc_email_on_started
attributes:
  bc_num_hours:
    widget: number_field
    min: 1
    max: 24
    step: 1
    value: 1
    label: "Wall time (hours)"
    help: "Maximum walltime for the session (hours)."
    required: true
  bc_num_slots:
    widget: number_field
    label: "Number of cores"
    value: 1
    min: 1
    max: 64
    step: 1
    help: "Number of CPU cores to request (4 GB per core)."
    required: true
  bc_vnc_resolution:
    required: true
  version:
    widget: select
    label: "Bandage version"
    help: "Select the version of Bandage to launch."
    options:
      - ["Bandage 0.9.0", "/path/to/apptainer_images/bandage/bandage.sif"]