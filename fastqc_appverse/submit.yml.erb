<%-
  cores = num_cores.to_i
  slurm_args = ["--nodes", "1", "--ntasks-per-node", "#{cores}", "--mem-per-cpu", "#{mem_per_cpu}G", "--partition", "#{node_type}"]
-%>
---
batch_connect:
  template: "vnc"
script:
  accounting_id: "<%= account %>"
  queue_name: <%= node_type %>
  native:
  <%- slurm_args.each do |arg| %>
  - "<%= arg %>"
  <%- end %>